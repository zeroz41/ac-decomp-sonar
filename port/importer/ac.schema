# The console layouts ac-import converts (sonarlib docs/roadmap.md, M6 steps 6c and 11c), written by hand from the
# game's headers: a JKR archive's four structures (JKRArchive.h:64-155), Town's item layer (m_field_make.h:281-285) and
# a texture's header (jsyswrap.h:14-37). The archive's types are nested in JKRArchive, so sonar_add_schema compiles the
# converters as C++.
struct ArcHeader size 0x20 type "JKRArchive::SArcHeader"
    u32  signature           0x00
    u32  file_length         0x04
    u32  header_length       0x08
    u32  file_data_offset    0x0C
    u32  file_data_length    0x10
    u32  _14                 0x14    # JKRCompArchive: the part kept in main RAM
    u32  _18                 0x18    # JKRCompArchive: the part kept in ARAM
    u32  _1C                 0x1C
end
struct ArcDataInfo size 0x20 type "JKRArchive::SArcDataInfo"
    u32  num_nodes           0x00
    u32  node_offset         0x04
    u32  num_file_entries    0x08
    u32  file_entry_offset   0x0C
    u32  string_table_length 0x10
    u32  string_table_offset 0x14
    u16  nextFreeFileID      0x18
    u8   isSyncIDs           0x1A    # a bool on the host
    u8   _1B[5]              0x1B bytes
end
struct DirEntry size 0x10 type "JKRArchive::SDIDirEntry"
    u32  mType               0x00
    u32  mOffset             0x04
    u16  _08                 0x08
    u16  mNum                0x0A
    u32  mFirstIdx           0x0C
end
struct FileEntry size 0x14 type "JKRArchive::SDIFileEntry"
    u16  mFileID             0x00
    u16  mHash               0x02
    u32  mFlag               0x04    # attributes in the top 8 bits, the name's offset below
    u32  mDataOffset         0x08
    u32  mSize               0x0C
    ptr  mData               0x10 null
end
struct FgData size 0x206 type "mFM_fg_data_c"
    u16  fg_id               0x000
    u16  items[16][16]       0x002
    u8   haniwa_step[4]      0x202 bytes
end
# The header of each banner and icon texture the card files take (jsyswrap.cpp:412-452). mCD_set_bti_data reads its
# offsets natively and copies the texels and palette after it as they are (m_card_bti.c_inc). The four GXBools are
# bool in C++.
struct CResTIMG size 0x20 type "CResTIMG" same
    u8  mTextureFormat     0x00
    u8  mTransparency      0x01
    u16 mSizeX             0x02
    u16 mSizeY             0x04
    u8  mWrapS             0x06
    u8  mWrapT             0x07
    u8  mPaletteFormat     0x08
    u8  mColorFormat       0x09
    u16 mPaletteEntryCount 0x0A
    u32 mPaletteOffset     0x0C
    u8  mIsMIPmapEnabled   0x10
    u8  mDoEdgeLOD         0x11
    u8  mIsBiasClamp       0x12
    u8  mIsMaxAnisotropy   0x13
    u8  mMinFilterType     0x14
    u8  mMagFilterType     0x15
    s8  mMinLOD            0x16
    s8  mMaxLOD            0x17
    u8  mTotalImageCount   0x18
    u8  _19                0x19
    s16 mLODBias           0x1A
    u32 mImageDataOffset   0x1C
end

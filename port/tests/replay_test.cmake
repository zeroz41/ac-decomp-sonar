# Runs the town replay (port/NOTES.md, Replays; sonarlib docs/roadmap.md, M6 step 9f1):
#   cmake -DAC_IMPORT=<ac-import> -DAC_PORT=<ac_port> -DSL_REPLAY=<sl-replay> -DSCRIPT=<town_replay.txt>
#         -DAC_DISC=<disc> -DAC_VERSION=<version> -DOUT_DIR=<dir> -P replay_test.cmake
# ac-import writes the package from the player's disc into OUT_DIR, and sl-replay builds the script into a recording
# there. ac_port runs once without a replay, to play's first frame, then with --replay twice and once with --validate.
# Each replay must exit 0 with a play line and a replay line at the tick after the recording's last, 38001, and the
# three runs must print the same lines. The replay line's scene must be 7, the town, its frame must hold instances and
# a hash, with nothing refused, stray, unowned, invalid or overflowed, the GX glue's counts must all be 0, and the
# game's sound and the DSP must have sounded. The play line must be the one the run without a replay prints, but for
# its scene. When AC_DISC names no disc it prints the line the test's SKIP_REGULAR_EXPRESSION matches and returns.
cmake_minimum_required(VERSION 3.25)

if("${AC_DISC}" STREQUAL "")
    message("ac_port_replay: skipped, AC_DISC is not set")
    return()
endif()
foreach(variable IN ITEMS AC_IMPORT AC_PORT SL_REPLAY SCRIPT AC_VERSION OUT_DIR)
    if("${${variable}}" STREQUAL "")
        message(FATAL_ERROR "ac_port_replay: ${variable} is not set")
    endif()
endforeach()

file(MAKE_DIRECTORY "${OUT_DIR}")
set(package "${OUT_DIR}/${AC_VERSION}.slpack")
execute_process(COMMAND "${AC_IMPORT}" "${AC_DISC}" "${package}" "${OUT_DIR}/cache"
                RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "ac_port_replay: ac-import failed (${result}):\n${output}${errors}")
endif()
message("ac-import: ${output}")

set(recording "${OUT_DIR}/town_replay.slir")
file(REMOVE "${recording}")
execute_process(COMMAND "${SL_REPLAY}" build "${SCRIPT}" "${recording}"
                RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
if(NOT result EQUAL 0 OR NOT EXISTS "${recording}")
    message(FATAL_ERROR "ac_port_replay: sl-replay failed (${result}):\n${output}${errors}")
endif()
message("${output}")

set(count "[0-9]+")
set(line_pattern "ac_port: [a-z]+ tick ${count} retrace ${count} gx ${count} dvd ${count} ${count} hash [0-9a-f]+")
string(APPEND line_pattern " instances ${count} compiles ${count} holes ${count}/${count} cpu ${count}")
string(APPEND line_pattern " refused ${count} views ${count} invalid ${count} problems ${count} overflows ${count}")
string(APPEND line_pattern " unowned ${count} strays ${count} gx-errors ${count} unmapped ${count} outside ${count}")
string(APPEND line_pattern " nested ${count} refused-frames ${count} audio ${count} loud ${count} dsp ${count}")
string(APPEND line_pattern " sound [0-9a-f]+")

# The play line without a replay, whole: it names no scene.
execute_process(COMMAND "${AC_PORT}" --package "${package}"
                RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 1200)
string(REGEX MATCH "${line_pattern}[^\n]*" plain "${output}")
message("run plain: exit ${result}: ${plain}")
if(NOT result EQUAL 0 OR NOT plain MATCHES "^ac_port: play ")
    message(FATAL_ERROR "ac_port_replay: the run without a replay did not reach play's first frame:\n${errors}")
endif()

set(runs "")
foreach(run IN ITEMS 1 2 validate)
    set(options "")
    if(run STREQUAL "validate")
        set(options --validate)
    endif()
    string(TIMESTAMP started "%s")
    execute_process(COMMAND "${AC_PORT}" --package "${package}" --replay "${recording}" ${options}
                    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 1200)
    string(TIMESTAMP ended "%s")
    math(EXPR seconds "${ended} - ${started}")
    string(REGEX MATCHALL "${line_pattern} scene ${count}" lines "${output}")
    list(LENGTH lines found)
    message("run ${run}: exit ${result}, ${seconds} s:")
    foreach(line IN LISTS lines)
        message("  ${line}")
    endforeach()
    set(play "")
    set(replay "")
    if(found EQUAL 2)
        list(GET lines 0 play)
        list(GET lines 1 replay)
    endif()
    if(NOT result EQUAL 0 OR NOT play MATCHES "^ac_port: play " OR NOT replay MATCHES "^ac_port: replay tick 38001 ")
        string(LENGTH "${errors}" length)
        if(length GREATER 4000)
            math(EXPR from "${length} - 4000")
            string(SUBSTRING "${errors}" ${from} -1 errors)
        endif()
        message(FATAL_ERROR "ac_port_replay: run ${run} did not end with the replay at tick 38001:\n${errors}")
    endif()
    list(APPEND runs "${play}|${replay}")
endforeach()
list(GET runs 0 first)
foreach(other IN LISTS runs)
    if(NOT other STREQUAL first)
        message(FATAL_ERROR "ac_port_replay: the runs differ:\n${runs}")
    endif()
endforeach()
string(REPLACE "|" ";" first "${first}")
list(GET first 0 play)
list(GET first 1 replay)

string(REGEX REPLACE " scene [0-9]+$" "" play_without_scene "${play}")
if(NOT play_without_scene STREQUAL plain)
    message(FATAL_ERROR "ac_port_replay: the replay's play line is not the run's without a replay:\n${play}\n${plain}")
endif()

string(REGEX MATCH " scene ([0-9]+)$" ignored "${replay}")
if(NOT CMAKE_MATCH_1 EQUAL 7)
    message(FATAL_ERROR "ac_port_replay: the replay did not end in the town, scene 7:\n${replay}")
endif()
string(REGEX MATCH " hash ([0-9a-f]+) instances ([0-9]+) " ignored "${replay}")
if(CMAKE_MATCH_2 EQUAL 0 OR CMAKE_MATCH_1 MATCHES "^0+$")
    message(FATAL_ERROR "ac_port_replay: the replay's last frame has no instances or no hash:\n${replay}")
endif()
set(count_pattern " refused ([0-9]+) views ([0-9]+) invalid ([0-9]+) problems [0-9]+ overflows ([0-9]+)")
string(APPEND count_pattern " unowned ([0-9]+) strays ([0-9]+) ")
string(REGEX MATCH "${count_pattern}" ignored "${replay}")
set(counts "${CMAKE_MATCH_1};${CMAKE_MATCH_2};${CMAKE_MATCH_3};${CMAKE_MATCH_4};${CMAKE_MATCH_5};${CMAKE_MATCH_6}")
set(names "refused;views;invalid;overflows;unowned;strays")
foreach(value name IN ZIP_LISTS counts names)
    if(NOT value EQUAL 0)
        message(FATAL_ERROR "ac_port_replay: the replay's ${name} is not 0:\n${replay}")
    endif()
endforeach()
string(REGEX MATCH
       " gx-errors ([0-9]+) unmapped ([0-9]+) outside ([0-9]+) nested ([0-9]+) refused-frames ([0-9]+) audio ([0-9]+) "
       ignored "${replay}")
set(gx_counts "${CMAKE_MATCH_1};${CMAKE_MATCH_2};${CMAKE_MATCH_3};${CMAKE_MATCH_4};${CMAKE_MATCH_5}")
set(gx_names "gx-errors;unmapped;outside;nested;refused-frames")
foreach(value name IN ZIP_LISTS gx_counts gx_names)
    if(NOT value EQUAL 0)
        message(FATAL_ERROR "ac_port_replay: the GX glue's ${name} is not 0:\n${replay}")
    endif()
endforeach()
if(NOT CMAKE_MATCH_6 GREATER 0)
    message(FATAL_ERROR "ac_port_replay: the game's sound mixed no output frames:\n${replay}")
endif()
string(REGEX MATCH " dsp ([0-9]+) " ignored "${replay}")
if(NOT CMAKE_MATCH_1 GREATER 0)
    message(FATAL_ERROR "ac_port_replay: the DSP rendered no sounding frame:\n${replay}")
endif()

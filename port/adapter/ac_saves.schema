    u8  upgrade_order_date.month 0x1
    u16 upgrade_order_date.year  0x2
    bits u8 0x4 { size:3 next_size:3 statue_rank:2 }
    bits u8 0x5 { renew:1 statue_ordered:1 basement_ordered:1 pad_1:1 pad:4 }
end
struct mHm_lyr_c size 0x228 type "mHm_lyr_c" same

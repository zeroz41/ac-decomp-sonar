end
struct Anmlet_c size 0x1 type "Anmlet_c" same
    bits u8 0x0 { exists:1 cond:1 send_reply:1 has_present_cloth:1 wearing_present_cloth:1 bit5_7:3 }
end
struct Anmplmail_c size 0x102 type "Anmplmail_c" same
    u8          font              0x0
    u8          paper_type        0x1
    u16         present           0x2
    u8          header_back_start 0x4
    u8          header[24]        0x5 bytes
    u8          body[192]         0x1D bytes
    u8          footer[32]        0xDD bytes
    u8          pad0              0xFD
    lbRTC_ymd_c date              0xFE
end
# A town's villagers and a passport's remove_animal take the land arms of memuni and anmuni; the islander, below,
# takes the island arms (m_npc.h:171-192).
struct Anmmem_c size 0x138 type "Anmmem_c" same
    PersonalID_c memory_player_id 0x0
    lbRTC_time_c last_speak_time  0x14
    Anmlnd_c     memuni.land      0x1C
    u64          saved_town_tune  0x28
    s8           friendship       0x30
    Anmlet_c     letter_info      0x31
    Anmplmail_c  letter           0x32
end
struct Anmhome_c size 0x5 type "Anmhome_c" same
    u8 type_unused 0x0
    u8 block_x     0x1
    u8 block_z     0x2
    u8 ut_x        0x3
    u8 ut_z        0x4
end
struct mQst_contest_c size 0x28 type "mQst_contest_c" same
    mQst_base_c  base                     0x0
    u16          requested_item           0xC
    PersonalID_c player_id                0xE
    s8           type                     0x22
    # The letter arm covers the flower arm's one byte, so it converts both.
    u8           info.letter_data.score   0x24
    u16          info.letter_data.present 0x26
end
struct AnmHPMail_c size 0x1C type "AnmHPMail_c" same
    lbRTC_time_c receive_time 0x0
    u8           password[20] 0x8 bytes
end
struct Animal_c size 0x988 type "Animal_c" same
    AnmPersonalID_c id                           0x0
    Anmmem_c        memories[7]                  0x10
    Anmhome_c       home_info                    0x898
    u8              catchphrase[10]              0x89D bytes
    mQst_contest_c  contest_quest                0x8A8
    u8              parent_name[8]               0x8D0 bytes
    u8              anmuni.previous_land_name[8] 0x8D8 bytes
    u16             previous_land_id             0x8E0
    u8              mood                         0x8E2
    u8              mood_time                    0x8E3
    u16             cloth                        0x8E4
    u16             remove_info                  0x8E6
    u8              is_home                      0x8E8
    u8              moved_in                     0x8E9
    u8              removing                     0x8EA
    u8              cloth_original_id            0x8EB
    u8              umbrella_id                  0x8EC
    u8              unk_8ED                      0x8ED
    u16             present_cloth                0x8EE
    u8              animal_relations[15]         0x8F0 bytes
    AnmHPMail_c     hp_mail[4]                   0x900
    u8              unused[24]                   0x970 bytes
end
struct mSP_goods_priority_list_c size 0x1 type "mSP_goods_priority_list_c" same
    bits u8 0x0 { a:2 b:2 c:2 pad:2 }
end
struct Shop_c size 0x140 type "Shop_c" same
    mSP_goods_priority_list_c priority_lists[5]            0x0
    PersonalID_c              unused_ids[10]               0x6
    u16                       items[39]                    0xCE
    u16                       rare_item                    0x11C
    u16                       lottery_items[3]             0x11E
    s8                        flowers_candy_grab_bag_count 0x124
    bits u16 0x126 { shop_info.shop_level:2 shop_info.upgrading_today:1 shop_info.send_upgrade_notice:1 shop_info.not_loaded_before:1 shop_info.paint_color:4 shop_info.unused:7 }
    u32                       sales_sum                    0x128
    lbRTC_time_c              exchange_time                0x12C
    lbRTC_time_c              renewal_time                 0x134
    s32                       visitor_flag                 0x13C
end

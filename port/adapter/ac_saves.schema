    s8          rank              0x4
    s8          rankdown_days     0x5
end
struct mPr_carde_data_c size 0x32 type "mPr_carde_data_c" same
    lbRTC_ymd_c letter_send_date      0x0
    u8          card_letters_sent[46] 0x4 bytes
end
struct Private_c size 0x2440 type "Private_c" same
    PersonalID_c          player_ID                           0x0
    s8                    gender                              0x14
    s8                    face                                0x15
    u8                    reset_count                         0x16
    mMsm_record_c         museum_record                       0x18
    u16                   inventory.pockets[15]               0x68
    u8                    inventory.lotto_ticket_expiry_month 0x86
    u8                    inventory.lotto_ticket_mail_storage 0x87
    u32                   inventory.item_conditions           0x88
    u32                   inventory.wallet                    0x8C
    u32                   inventory.loan                      0x90
    mQst_delivery_c       deliveries[15]                      0x94
    mQst_errand_c         errands[5]                          0x2EC
    u16                   equipment                           0x4A4
    Mail_hs_c             saved_mail_header                   0x4A6
    Mail_c                mail[10]                            0x4E0
    u16                   backgound_texture                   0x1084
    u8                    exists                              0x1086
    u8                    hint_count                          0x1087
    mPr_cloth_c           cloth                               0x1088
    AnmPersonalID_c       stored_anm_id                       0x108C
    mPr_destiny_c         destiny                             0x109A
    mPr_birthday_c        birthday                            0x10A4
    mPr_catalog_order_c   catalog_orders[5]                   0x10A8
    u8                    unk_10A8[24]                        0x10BC bytes
    u32                   aircheck_collect_bitfield[2]        0x10D4
    Anmremail_c           remail                              0x10DC
    u32                   reset_code                          0x10F4
    mPr_animal_memory_c   animal_memory                       0x10F8
    u8                    complete_fish_insect_flags          0x1102
    u16                   celebrated_birthday_year            0x1104
    u32                   furniture_collected_bitfield[43]    0x1108
    u32                   wall_collected_bitfield[3]          0x11B4
    u32                   carpet_collected_bitfield[3]        0x11C0
    u32                   paper_collected_bitfield[2]         0x11CC
    u32                   music_collected_bitfield[2]         0x11D4
    mPr_map_info_c        maps[8]                             0x11DC
    u32                   bank_account                        0x122C
    mNW_original_design_c my_org[8]                           0x1240
    u8                    my_org_no_table[8]                  0x2340 bytes
    u32                   state_flags                         0x2348
    mCD_player_calendar_c calendar                            0x234C
    u32                   soncho_trophy_field0                0x23B4
    mPr_day_day_c         nw_visitor                          0x23B8
    mPr_day_day_c         radiocard                           0x23BE
    mPr_sunburn_c         sunburn                             0x23C4
    u8                    unused_23CA[14]                     0x23CA bytes
    u16                   birthday_present_npc                0x23D8
    u8                    golden_items_collected              0x23DA
    u32                   soncho_trophy_field1                0x23DC
    mPr_carde_data_c      ecard_letter_data                   0x23E0
    u8                    unused_2412[46]                     0x2412 bytes
end
struct mLd_land_info_c size 0xC type "mLd_land_info_c" same

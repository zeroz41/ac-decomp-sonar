    s32 block_z 0x4
    s32 block_x 0x8
    s32 ut_z    0xC
    s32 ut_x    0x10
end
struct mEv_special_c size 0x54 type "mEv_special_c" same
    lbRTC_time_c   scheduled 0x0
    u32            kind      0x8
    # SHOP 0 to GYPSY 5; none (0xFFFFFFFF) has no case, so its zeros are copied.
    union event 0xC 0x48 by kind
    case 0
        mEv_bargin_c   bargin    0
    case 1
        mEv_designer_c designer  0
    case 2
        mEv_broker_c   broker    0
    case 3
        mEv_artist_c   artist    0
    case 4
        mEv_arabian_c  arabian   0
    case 5
        mEv_gypsy_c    gypsy     0
    end
end
struct mEv_kabu_peddler_c size 0x64 type "mEv_kabu_peddler_c" same
    PersonalID_c spoken_pids[5] 0x0
end
struct mEv_event_save_c size 0xBC type "mEv_event_save_c" same
    mEv_special_c      special             0x0
    mEv_kabu_peddler_c weekly.kabu_peddler 0x54  # the only arm the game reaches
    u32                flags               0xB8
end
struct mEv_event_save_info_c size 0x2 type "mEv_event_save_info_c" same

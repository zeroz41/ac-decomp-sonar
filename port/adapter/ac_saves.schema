# The console layouts of Animal Crossing's card files (sonarlib docs/roadmap.md, M6 step 11c; port/NOTES.md, Saves),
# written by hand from the game's headers. Every structure is `same`: the port's structures are the card's bytes on
# the host. The top structures are the town's Save_t and its three keep structures, the passport's mCD_foreigner_c
# and the gift letters' PresentSave_c; ac_saves.c converts the regions around them and the event save areas' data.
# The event areas' structures, at the end, are reached by no top structure: ac_saves.c calls them on data.
# ac_save_schema_check checks every structure against the port's DWARF.
struct lbRTC_time_c size 0x8 type "lbRTC_time_c" same
    u8  sec     0x0
    u8  min     0x1
    u8  hour    0x2
    u8  day     0x3
    u8  weekday 0x4
    u8  month   0x5
    u16 year    0x6
end
struct mFRm_chk_t size 0x14 type "mFRm_chk_t" same
    s32          version  0x0
    u32          code     0x4
    u16          land_id  0x8
    lbRTC_time_c time     0xA
    u16          checksum 0x12
end
struct PersonalID_c size 0x14 type "PersonalID_c" same
    u8  player_name[8] 0x0 bytes
    u8  land_name[8]   0x8 bytes
    u16 player_id      0x10
    u16 land_id        0x12
end
struct mMsm_remail_info_c size 0x4C type "mMsm_remail_info_c" same
    u8  types[15] 0x0 bytes
    u16 items[30] 0x10
end
struct mMsm_record_c size 0x4E type "mMsm_record_c" same
    bits u8 0x0 { contacted:1 remail_pending:1 send_info_mail:1 stored_fossil_num:5 }
    mMsm_remail_info_c remail_info 0x2
end
# The bit-fields are declared u32 but fill 16 bits, and time_limit sits at +2 on both compilers.
struct mQst_base_c size 0xC type "mQst_base_c" same
    bits u16 0x0 { quest_type:2 quest_kind:6 time_limit_enabled:1 progress:4 give_reward:1 unused:2 }
    lbRTC_time_c time_limit 0x2
end
struct AnmPersonalID_c size 0xE type "AnmPersonalID_c" same
    u16 npc_id       0x0
    u16 land_id      0x2
    u8  land_name[8] 0x4 bytes
    u8  name_id      0xC
    u8  looks        0xD
end
struct mQst_delivery_c size 0x28 type "mQst_delivery_c" same
    mQst_base_c     base      0x0
    AnmPersonalID_c recipient 0xC
    AnmPersonalID_c sender    0x1A
end
struct mQst_errand_chain_c size 0x2C type "mQst_errand_chain_c" same
    AnmPersonalID_c used_ids[3] 0x0
    u8              used_num    0x2A
end
struct mQst_firstjob_c size 0x1E type "mQst_firstjob_c" same
    AnmPersonalID_c used_ids[2] 0x0
    bits u8 0x1C { used_num:7 wrong_cloth:1 }
end
struct mQst_errand_c size 0x58 type "mQst_errand_c" same
    mQst_base_c         base      0x0
    AnmPersonalID_c     recipient 0xC
    AnmPersonalID_c     sender    0x1A
    u16                 item      0x28
    bits u8 0x2A { pockets_idx:5s errand_type:3s }
    # CHAIN (1) and FIRST_JOB (2) have an arm; NONE (0) converts as the chain arm, which covers the prefix both share.
    # Another value, one the game never sets, copies the union's bytes.
    union info 0x2C 0x2C by errand_type
    case 0,1
        mQst_errand_chain_c chain     0
    case 2
        mQst_firstjob_c     first_job 0
    end
end
struct Mail_hs_c size 0x3A type "Mail_hs_c" same
    s8 header_back_start 0x0
    u8 unknown           0x1
    u8 header[24]        0x2 bytes
    u8 footer[32]        0x1A bytes
end
struct Mail_nm_c size 0x16 type "Mail_nm_c" same
    PersonalID_c personalID 0x0
    u8           type       0x14
end
struct Mail_hdr_c size 0x2C type "Mail_hdr_c" same
    Mail_nm_c recipient 0x0
    Mail_nm_c sender    0x16
end
struct Mail_ct_c size 0xFC type "Mail_ct_c" same
    u8 font              0x0
    u8 header_back_start 0x1
    u8 mail_type         0x2
    u8 paper_type        0x3
    u8 header[24]        0x4 bytes
    u8 body[192]         0x1C bytes
    u8 footer[32]        0xDC bytes
end
struct Mail_c size 0x12A type "Mail_c" same
    Mail_hdr_c header  0x0
    u16        present 0x2C
    Mail_ct_c  content 0x2E
end
struct mPr_cloth_c size 0x4 type "mPr_cloth_c" same
    u16 idx  0x0
    u16 item 0x2
end
struct mPr_destiny_c size 0xA type "mPr_destiny_c" same
    lbRTC_time_c received_time 0x0
    u8           type          0x8
end
struct mPr_birthday_c size 0x4 type "mPr_birthday_c" same
    u16 year  0x0
    u8  month 0x2
    u8  day   0x3
end
struct mPr_catalog_order_c size 0x4 type "mPr_catalog_order_c" same
    u16 item       0x0
    u8  shop_level 0x2
end
struct lbRTC_ymd_c size 0x4 type "lbRTC_ymd_c" same
    u16 year  0x0
    u8  month 0x2
    u8  day   0x3
end
struct Anmremail_c size 0x16 type "Anmremail_c" same
    lbRTC_ymd_c date         0x0
    u8          name[8]      0x4 bytes
    u8          land_name[8] 0xC bytes
    bits u8 0x14 { flags.cond:1 flags.looks:7 }
end
struct mPr_animal_memory_c size 0xA type "mPr_animal_memory_c" same
    u16 npc_id       0x0
    u8  land_name[8] 0x2 bytes
end
struct mPr_map_info_c size 0xA type "mPr_map_info_c" same
    u8  land_name[8] 0x0 bytes
    u16 land_id      0x8
end
struct mNW_original_tex_c size 0x200 type "mNW_original_tex_c" same
    u8 data[512] 0x0 bytes
end
struct mNW_original_design_c size 0x220 type "mNW_original_design_c" same
    u8                 name[16]        0x0 bytes
    u8                 palette         0x10
    u8                 flag_design_set 0x11
    mNW_original_tex_c design          0x20
end
struct mCD_player_calendar_c size 0x68 type "mCD_player_calendar_c" same
    u32 played_days[12] 0x0
    u32 event_days[12]  0x30
    u16 event_flags     0x60
    u8  edit            0x62
    u8  pad_63          0x63
    u16 year            0x64
    u8  month           0x66
end
struct mPr_day_day_c size 0x6 type "mPr_day_day_c" same
    lbRTC_ymd_c last_date 0x0
    u8          days      0x4
end
struct mPr_sunburn_c size 0x6 type "mPr_sunburn_c" same

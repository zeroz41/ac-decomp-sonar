struct mHm_flg_c size 0x1 type "mHm_flg_c" same
    bits u8 0x0 { house_updated:1 has_saved:1 hra_member:1 has_basement:1 hra_reward0:1 hra_reward1:1 bit_6:1 bit_7:1 }
end
struct mHm_rmsz_c size 0x6 type "mHm_rmsz_c" same

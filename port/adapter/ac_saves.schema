    u8           num  0x8
    u8           pad  0x9
end
struct mHm_hs_c size 0x26B0 type "mHm_hs_c" same
    PersonalID_c ownerID             0x0
    u8           unk_14[6]           0x14 bytes
    TempoBeat_c  haniwa_tempo        0x1A
    lbRTC_ymd_c  hra_mark_time       0x1C
    u32          hra_mark_info       0x20

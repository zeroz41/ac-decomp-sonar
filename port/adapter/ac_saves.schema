    mHm_lyr_c       layer_storage1  0x450
    mHm_lyr_c       layer_storage2  0x678
    mHm_wf_c        wall_floor      0x8A0
    TempoBeat_c     tempo_beat      0x8A2
    mHm_fllot_bit_c floor_bit_info  0x8A4
end
struct Haniwa_Item_c size 0x8 type "Haniwa_Item_c" same
